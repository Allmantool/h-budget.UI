{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "SPA: Start Debug Server",
			"type": "shell",
			"command": "npm",
			"args": ["run", "start:debug"],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "spa-dev-server",
				"pattern": { "regexp": "a^" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Building\\.\\.\\.",
					"endsPattern": "Local:\\s+https://localhost:4200/?"
				}
			},
			"presentation": {
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"group": "spa-development",
				"clear": true
			},
			"runOptions": { "instanceLimit": 1 }
		},
		{
			"label": "SPA: Start Development Server",
			"type": "shell",
			"command": "npm",
			"args": ["run", "start"],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "spa-dev-server",
				"pattern": { "regexp": "a^" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Building\\.\\.\\.",
					"endsPattern": "Local:\\s+https://localhost:4200/?"
				}
			},
			"presentation": {
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"group": "spa-development",
				"clear": true
			},
			"runOptions": { "instanceLimit": 1 }
		},
		{
			"label": "SPA: Unit Tests",
			"type": "shell",
			"command": "npm",
			"args": ["run", "test"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": false, "panel": "shared", "clear": true }
		},
		{
			"label": "SPA: Unit Tests - Watch",
			"type": "shell",
			"command": "npm",
			"args": ["run", "test:watch"],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "karma",
				"pattern": { "regexp": "a^" },
				"background": { "activeOnStart": true, "endsPattern": "Karma.*server started" }
			},
			"presentation": {
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"group": "spa-tests",
				"clear": true
			},
			"runOptions": { "instanceLimit": 1 }
		},
		{
			"label": "SPA: Unit Tests - Debug Watch",
			"type": "shell",
			"command": "npm",
			"args": ["run", "test:debug"],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "karma",
				"pattern": { "regexp": "a^" },
				"background": { "activeOnStart": true, "endsPattern": "Connected on socket.*Chrome" }
			},
			"presentation": {
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"group": "spa-tests",
				"clear": true
			},
			"runOptions": { "instanceLimit": 1 }
		},
		{
			"label": "SPA: Unit Tests - Coverage",
			"type": "shell",
			"command": "npm",
			"args": ["run", "test"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": false, "panel": "shared", "clear": true }
		},
		{
			"label": "SPA: Lint",
			"type": "shell",
			"command": "npm",
			"args": ["run", "lint"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$eslint-stylish",
			"presentation": { "reveal": "always", "focus": false, "panel": "shared", "clear": true }
		},
		{
			"label": "SPA: Format Check",
			"type": "shell",
			"command": "npm",
			"args": ["run", "format:check"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": false, "panel": "shared", "clear": true }
		},
		{
			"label": "SPA: Type Check",
			"type": "shell",
			"command": "npm",
			"args": ["run", "typecheck"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$tsc",
			"presentation": { "reveal": "always", "focus": false, "panel": "shared", "clear": true }
		},
		{
			"label": "SPA: Build Development",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": false, "panel": "shared", "clear": true }
		},
		{
			"label": "SPA: Build Production",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build:prod"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": false, "panel": "shared", "clear": true }
		},
		{
			"label": "SPA: Verify",
			"dependsOn": ["SPA: Type Check", "SPA: Lint", "SPA: Format Check", "SPA: Unit Tests", "SPA: Build Production"],
			"dependsOrder": "sequence",
			"presentation": { "reveal": "always", "focus": false, "panel": "shared" }
		}
	]
}
